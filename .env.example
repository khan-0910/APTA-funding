# APTA Empowers environment configuration
# Copy to .env.local and fill in your Supabase project credentials.
#
# WITH Supabase (recommended):
#   All 7 tables (accounts, login logs, applications, beneficiaries, transactions,
#   partners, progress reports) are read from and written to PostgreSQL.
#   Every change syncs automatically within ~1 second of a mutation.
#
# WITHOUT Supabase (empty values):
#   The app runs entirely on this device's localStorage. Data starts empty —
#   create your own accounts at /register and fill in your own data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
